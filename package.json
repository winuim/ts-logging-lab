{
  "name": "ts-logging-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:part-01": "npm run build && node examples/part-01.mjs",
    "browser:install": "puppeteer browsers install chrome",
    "example:part-02": "npm run build && node examples/part-02.mjs",
    "example:part-03": "npm run build && node examples/part-03.mjs",
    "example:part-06": "npm run build && node examples/part-06.mjs",
    "example:part-07": "npm run build && node examples/part-07.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "puppeteer": "25.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
